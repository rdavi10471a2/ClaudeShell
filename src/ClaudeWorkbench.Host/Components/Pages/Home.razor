@page "/"

<PageTitle>@PageTitleText</PageTitle>

@* ClaudeWorkbench --Basic: a plain Claude shell. Command bar + the assistant tab,
   backed by the BasicSidecar. No governance, no source/git/tasks, no indexing. *@

<section class="control-screen">
    <header class="command-bar">
        <div class="title-strip">
            <div class="brand-lockup">
                <div class="brand-text">
                    <h1>ClaudeWorkbench <span class="brand-basic">--Basic</span></h1>
                </div>
            </div>
        </div>
        <div class="command-bar-actions">
            <span class="wb-status">
                <span class="wb-flag" title="@ClaudeCue.Title">
                    <span class="wb-dot @ClaudeCue.Css"></span>@ClaudeCue.Label
                </span>
            </span>
            <RadzenButton Icon="help_outline"
                          Text="Help"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="How ClaudeWorkbench --Basic works"
                          Click="@(() => helpOpen = true)" />
            <button type="button" class="wb-about-link" @onclick="@(() => aboutOpen = true)" title="What is best in life?">About</button>
            <RadzenButton Icon="settings"
                          Text="Settings"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Agent settings — model, reasoning level"
                          Click="@(() => settingsOpen = true)" />
        </div>
    </header>

    <main class="control-grid">
        <section class="work-panel">
            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Assistant">
                        <AssistantTab />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </section>
    </main>

    <AgentSettingsDialog Visible="@settingsOpen" OnClose="@(() => settingsOpen = false)" />

    <HelpDialog Visible="@helpOpen" OnClose="@(() => helpOpen = false)" />

    @if (aboutOpen)
    {
        <div class="wb-about-backdrop" @onclick="@(() => aboutOpen = false)">
            <div class="wb-about-frame" @onclick:stopPropagation="true">
                <button type="button" class="wb-about-close" @onclick="@(() => aboutOpen = false)" aria-label="Close">&times;</button>
                <img class="wb-about-img" src="images/about-poster.png"
                     alt="What is best in life? — ClaudeWorkbench, governed barbarian" />
            </div>
        </div>
    }

</section>
